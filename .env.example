# Variables de entorno de la app. Copia este archivo a `.env` para desarrollo local.
# `.env` no se versiona (principio 5); en Vercel cada entorno define las suyas.

# Postgres. En local, el de `pnpm db:up` (Docker, puerto 5433).
# En producción, la URL con pooling de Neon (host `-pooler`, ADR 004).
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/liga_dev"

# Solo en Vercel (producción y preview): URL directa de Neon, sin `-pooler`.
# La usa `prisma migrate deploy` en el build; la app no la lee.
# En local no se define: DATABASE_URL ya es una conexión directa.
# DATABASE_URL_UNPOOLED=""

# Secreto con el que Better Auth firma sesiones y tokens. Mínimo 32 caracteres.
# Genera uno distinto por entorno con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL pública de la app. En producción, la URL de Vercel; en las URLs de prueba
# de Vercel no se define (Better Auth usa el origen de cada petición).
BETTER_AUTH_URL="http://localhost:3000"

# Código de invitación que el profesor entrega a los ayudantes para registrarse.
# Mínimo 8 caracteres. Para cambiarlo, se cambia esta variable y se redespliega.
INVITE_CODE=""
