# Variables de entorno de la app. Copia este archivo a `.env` para desarrollo local.
# `.env` no se versiona (principio 5); en Vercel cada entorno define las suyas.

# Postgres. En local, el de `pnpm db:up` (Docker, puerto 5433).
# En producción, la URL con pooling de Neon (host `-pooler`, ADR 004).
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/liga_dev"

# Solo en Vercel (producción y preview): URL directa de Neon, sin `-pooler`.
# La usa `prisma migrate deploy` en el build; la app no la lee.
# En local no se define: DATABASE_URL ya es una conexión directa.
# DATABASE_URL_UNPOOLED=""
